# Copy to .env and fill in real values. Never commit .env.

PORT=4000

# Sarvam AI (https://dashboard.sarvam.ai) - generate under API Keys
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# Translation model: mayura:v1 (12 languages, all modes) or
# sarvam-translate:v1 (all 22 scheduled languages, formal only)
SARVAM_TRANSLATE_MODEL=mayura:v1

# STT model: saaras:v3 is current/recommended
SARVAM_STT_MODEL=saaras:v3

# TTS model + default speaker (see Sarvam docs for full voice list)
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=anushka

# Comma-separated list of origins allowed to call this API
CORS_ORIGIN=http://localhost:3000,capacitor://localhost,http://10.0.2.2

# Google Gemini (https://aistudio.google.com/apikey) - used by
# /api/voice/extract and /api/v1/intake to turn spoken transcripts into
# structured form fields (income, Aadhaar, phone, location, etc.)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Timeout for a single Gemini call, in milliseconds
GEMINI_TIMEOUT_MS=15000

# OpenStreetMap Overpass API (no key required) - used by the market tool
# to count nearby competitors for a proposed business.
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_MS=10000

# data.gov.in (https://data.gov.in) - register for a free API key, then
# used by the market tool for mandi (wholesale market) commodity prices.
# Resource: "Current Daily Price of Various Commodities from Various
# Markets (Mandi)"
DATA_GOV_API_KEY=your_data_gov_api_key_here
DATA_GOV_MANDI_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
DATA_GOV_TIMEOUT_MS=10000
