{
  "name": "gramudyam-api",
  "version": "1.0.0",
  "description": "GramUdyam backend: proxies translation, speech-to-text and text-to-speech to Sarvam AI so the API key never ships in the app.",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "test:phase1": "node --test tests/phase1.test.js",
    "test:phase2": "node --test tests/phase2.test.js",
    "test:phase3": "node --test tests/phase3.test.js",
    "test:phase4": "node --test tests/phase4.test.js",
    "test:phase5": "node --test tests/phase5.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "multer": "^1.4.5-lts.1",
    "node-fetch": "^3.3.2",
    "zod": "^4.4.3"
  }
}
